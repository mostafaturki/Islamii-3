<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Islamii3" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->

        <!--                Primary Color          -->
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryVariant">@color/dark_blue_variant</item>
        <item name="colorOnPrimary">@color/black</item>

        <!--                Secondary Color          -->
        <item name="colorSecondary">@color/dark_blue</item>
        <item name="colorSecondaryVariant">@color/dark_blue_variant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!--                Status Bar Color        -->
        <item name="android:statusBarColor">@color/dark_blue</item>

    </style>

    <style name="navigation_menu">
        <item name="android:background">@color/dark_blue</item>
        <item name="itemIconSize"> 32dp</item>
        <item name= "itemIconTint">@color/nav_menu_dark</item>
        <item name= "itemTextColor">@color/nav_menu_dark</item>
    </style>

    <style name="splash">
        <item name="android:background">@drawable/img_splash_dark</item>
    </style>
    <style name="home">
        <item name="android:background">@drawable/img_home_dark</item>
    </style>
    <style name="quranTitle">
        <item name="android:textColor">@color/gold2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="quranContent">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20dp</item>
        <item name="android:gravity">center</item>
    </style>
    
    
</resources>